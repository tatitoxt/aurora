{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and edge overlays may listen to app events and read windows.",
  "windows": ["player", "edge-*", "settings-*", "hud", "desklyrics"],
  "permissions": [
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:default",
    "dialog:default",
    "dialog:allow-open",
    "notification:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
