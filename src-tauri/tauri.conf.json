{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noctbeat",
  "version": "0.1.0",
  "identifier": "com.noctbeat.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "player",
        "title": "Noctbeat",
        "width": 340,
        "height": 560,
        "resizable": true,
        "minWidth": 300,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar",
            "acrylic",
            "blur"
          ],
          "state": "active",
          "radius": 18
        },
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../extension"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "A floating glass HUD, synced lyrics and a fullscreen stage that follow whatever music is playing on your computer.",
    "longDescription": "A floating glass HUD, synced lyrics and a fullscreen stage that follow whatever music is playing on your computer.",
    "copyright": "Copyright (c) 2026 Fausto Pastura",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0NzJBQzA3QjZCNTQyQ0YKUldUUFFyVzJCNnh5WlA0R3QwOU9Mdmk5bVZZVUgxL1pTbVp4a2lUQ0kzVjE5YWlMSkdGdlBCVWgK",
      "endpoints": [
        "https://github.com/tatitoxt/aurora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
